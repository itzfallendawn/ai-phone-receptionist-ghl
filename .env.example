# GoHighLevel (Settings → Private Integrations → create a token with calendars and contacts scopes)
GHL_API_KEY=pit-your-private-integration-token
GHL_LOCATION_ID=your-location-id
GHL_CALENDAR_ID=your-calendar-id
GHL_TIMEZONE=America/New_York

# Optional: phone number used when testing without a real call
TEST_PHONE=+15550000000

# Optional: Slack incoming webhook for the error-alert workflow
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Self-hosted n8n must allow $env access in nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
