        "responseBody": "={{ JSON.stringify({ results: [{ toolCallId: $('Extract Tool Call').item.json.toolCallId, result: 'I am sorry, I am having trouble checking the calendar right now. Could you try again in a moment, or I can have our team call you back?' }] }) }}",
        "options": {}
      }
    }
