    },
    {
      "id": "http-note",
      "name": "GHL: Add Note",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "continueOnFail": true,
      "position": [
        2600,
        810
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://services.leadconnectorhq.com/contacts/' + $('Set Contact ID').item.json.contactId + '/notes/' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $('Set Contact ID').item.json.ghlApiKey }}"
            },
            {
              "name": "Version",
              "value": "2021-07-28"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ body: 'VAPI call: appointment booked by the AI receptionist\\nCaller: ' + $('Set Contact ID').item.json.callerName + '\\nPhone: ' + $('Set Contact ID').item.json.callerPhone + '\\nTime: ' + $('Set Contact ID').item.json.requestedTimeISO + '\\nReason: ' + ($('Set Contact ID').item.json.reason || 'Not specified') }) }}"
      }
    },
    {
      "id": "resp-failed",
      "name": "Respond: Book Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2600,
        640
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ results: [{ toolCallId: $('Extract Tool Call').item.json.toolCallId, result: 'I am sorry, something went wrong with the booking. Please call us back or try a different time.' }] }) }}"
      }
    },
    {
      "id": "resp-unknown",
      "name": "Respond: Unknown Tool",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1280,
        850
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ results: [{ toolCallId: $json.toolCallId || 'unknown', result: 'I am not sure how to handle that request. Let me transfer you to our team.' }] }) }}"
      }
    },
    {
      "id": "respond-slots-failed",
      "name": "Respond: Slots Failed",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
